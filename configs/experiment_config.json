{
  "dataset": "Fashion-MNIST",
  "random_seed": 42,
  "num_classes": 10,
  "image_height": 28,
  "image_width": 28,
  "channels": 1,
  "image_layout": "NHWC",
  "train_samples_per_class": 1000,
  "test_samples_per_class": 200,
  "train_samples_total": 10000,
  "test_samples_total": 2000,
  "normalization": "divide_by_255",
  "architecture": {
    "input_shape": [28, 28, 1],
    "layers": [
      {
        "type": "conv2d",
        "filters": 8,
        "kernel_size": 3,
        "stride": 1,
        "padding": "valid",
        "use_bias": true
      },
      {
        "type": "relu"
      },
      {
        "type": "maxpool2d",
        "pool_size": 2,
        "stride": 2,
        "padding": "valid"
      },
      {
        "type": "flatten"
      },
      {
        "type": "dense",
        "units": 10,
        "use_bias": true,
        "activation": "linear"
      },
      {
        "type": "softmax"
      }
    ]
  },
  "initialization": {
    "weights": "he_normal",
    "biases": "zeros"
  },
  "batch_size": 32,
  "initial_epochs": 5,
  "optimizer": "SGD",
  "learning_rate": 0.01,
  "loss": "categorical_crossentropy",
  "loss_reduction": "mean"
}
